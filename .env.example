# Optional reputation services. Keep real values in an untracked .env file.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ENABLE_GEMINI_EXPLANATIONS=true

# Backend-only URL lookups are enabled by default. Set false for offline tests.
ENABLE_NETWORK_LOOKUPS=true
REQUEST_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=4
MAX_REDIRECT_HOPS=5
DATABASE_PATH=./safenest_cache.db
